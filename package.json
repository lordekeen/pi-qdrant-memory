{
  "name": "pi-qdrant-memory",
  "version": "0.3.2",
  "description": "Semantic, cross-session retrieval over durable conversation knowledge for pi.dev, backed by Qdrant.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "memory",
    "qdrant",
    "embeddings",
    "semantic-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordekeen/pi-qdrant-memory.git"
  },
  "homepage": "https://github.com/lordekeen/pi-qdrant-memory#readme",
  "bugs": "https://github.com/lordekeen/pi-qdrant-memory/issues",
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "src/",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "LICENSE",
    "pi-qdrant-memory-config.example.json"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:smoke": "QDRANT_MEMORY_SMOKE=1 node --test test/integration.smoke.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
